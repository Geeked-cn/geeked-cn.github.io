<%
let docTitle = page.title;
if (!docTitle) {
  if (page.archive && page.year) {
    docTitle = page.year + ' 年' + (page.month ? ' ' + page.month + ' 月' : '') + __('archive');
  } else if (page.tag) {
    docTitle = '#' + page.tag;
  } else if (page.category) {
    docTitle = page.category;
  } else {
    docTitle = config.subtitle || config.title;
  }
}
const fullTitle = kind === 'hero' ? config.title : docTitle + ' | ' + config.title;
// canonical 必须是绝对地址：去掉 index.html 后缀，再拼上站点域名
const canonicalPath = (page.path || '').replace(/index\.html$/, '');
const canonicalUrl = config.url.replace(/\/+$/, '') + url_for('/' + canonicalPath);
%>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= fullTitle %></title>
  <% if (page.description || config.description) { %>
  <meta name="description" content="<%= page.description || config.description %>">
  <% } %>
  <% if (config.keywords) { %>
  <meta name="keywords" content="<%= config.keywords %>">
  <% } %>
  <meta name="theme-color" content="#ffffff">
  <meta name="color-scheme" content="light">
  <%- meta_generator() %>
  <% if (is_post()) { %>
  <meta property="og:type" content="article">
  <% } else { %>
  <meta property="og:type" content="website">
  <% } %>
  <meta property="og:title" content="<%- docTitle %>">
  <meta property="og:site_name" content="<%- config.title %>">
  <meta property="og:url" content="<%- canonicalUrl %>">
  <link rel="canonical" href="<%- canonicalUrl %>">
  <link rel="alternate" type="application/atom+xml" title="<%- config.title %>" href="<%- url_for('/atom.xml') %>">
  <link rel="icon" href="<%- url_for('/favicon.svg') %>" type="image/svg+xml">
  <link rel="preload" as="style" href="<%- url_for('/css/style.css') %>">
  <link rel="stylesheet" href="<%- url_for('/css/style.css') %>">
</head>
