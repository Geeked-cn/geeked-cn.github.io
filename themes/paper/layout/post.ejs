<article class="post">
  <header class="wrap post-header reveal">
    <p class="post-kicker">
      <time datetime="<%= date_xml(page.date) %>"><%= date(page.date, 'YYYY 年 MM 月 DD 日') %></time>
    </p>
    <h1 class="post-title"><%= page.title %></h1>
    <div class="post-meta">
      <% if (page.categories && page.categories.length) { %>
      <% page.categories.forEach(function (cat) { %>
      <a class="chip" href="<%- url_for(cat.path) %>"><%= cat.name %></a>
      <% }) %>
      <% } %>
      <% if (page.tags && page.tags.length) { %>
      <% page.tags.forEach(function (tag) { %>
      <a class="chip chip-ghost" href="<%- url_for(tag.path) %>">#<%= tag.name %></a>
      <% }) %>
      <% } %>
    </div>
  </header>

  <div class="wrap post-body-wrap">
    <% const tocHtml = theme.toc === false ? '' : toc(page.content); %>
    <% if (tocHtml) { %>
    <details class="toc" open>
      <summary><%= __('contents') %></summary>
      <%- tocHtml %>
    </details>
    <% } %>

    <div class="post-content">
      <%- page.content %>
    </div>

    <% if (page.updated && date(page.updated, 'YYYY-MM-DD') !== date(page.date, 'YYYY-MM-DD')) { %>
    <p class="post-updated"><%= __('updated_on') %> <time datetime="<%= date_xml(page.updated) %>"><%= date(page.updated, 'YYYY 年 MM 月 DD 日') %></time></p>
    <% } %>
  </div>

  <nav class="wrap post-nav">
    <% if (page.prev) { %>
    <a class="post-nav-link prev" href="<%- url_for(page.prev.path) %>">
      <span class="post-nav-label"><%= __('prev') %></span>
      <span class="post-nav-title"><%= page.prev.title %></span>
    </a>
    <% } %>
    <% if (page.next) { %>
    <a class="post-nav-link next" href="<%- url_for(page.next.path) %>">
      <span class="post-nav-label"><%= __('next') %></span>
      <span class="post-nav-title"><%= page.next.title %></span>
    </a>
    <% } %>
  </nav>
</article>
