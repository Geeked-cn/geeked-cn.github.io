<%
// 页面标题：文章/页面用自己的标题，归档、标签、分类页做语义化回退
let docTitle = page.title;
if (!docTitle) {
  if (is_archive() && page.archive) {
    docTitle = page.year
      ? page.year + ' 年' + (page.month ? ' ' + page.month + ' 月' : '') + '归档'
      : __('archives');
  } else if (page.tag) {
    docTitle = '#' + page.tag;
  } else if (page.category) {
    docTitle = page.category;
  } else {
    docTitle = config.subtitle || config.title;
  }
}
%>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= is_home() ? config.title : docTitle + ' | ' + config.title %></title>
  <% if (page.description || config.description) { %>
  <meta name="description" content="<%= page.description || config.description %>">
  <% } %>
  <% if (config.keywords) { %>
  <meta name="keywords" content="<%= config.keywords %>">
  <% } %>
  <%- meta_generator() %>
  <% if (is_post()) { %>
  <meta property="og:type" content="article">
  <meta property="og:title" content="<%= docTitle %>">
  <meta property="og:site_name" content="<%= config.title %>">
  <% } else { %>
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= is_home() ? config.title : docTitle %>">
  <% } %>
  <link rel="canonical" href="<%- url_for(page.path || '/', true) %>">
  <link rel="alternate" type="application/atom+xml" title="<%= config.title %>" href="<%- url_for('/atom.xml') %>">
  <link rel="icon" href="<%- url_for('/favicon.svg') %>" type="image/svg+xml">
  <meta name="theme-color" content="<%- theme.accent || '#b5442e' %>">
  <link rel="stylesheet" href="<%- url_for('/css/style.css') %>">
</head>
