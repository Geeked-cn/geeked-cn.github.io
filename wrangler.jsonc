{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xhxh-blog",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "www.xhxh.eu.cc",
      "custom_domain": true
    }
  ]
}
